--- !u!114 &461182406
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 461182404}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u05D4\u05DE\u05D9\u05D9\u05E0\u05D4 \u05D4\u05DE\u05E6\u05D5\u05D9\u05D4
    \u05D4\u05D9\u05D0 \u05DE\u05D9\u05DF \u05E4\u05D5\u05DC\u05E9 \u05DE\u05D0\u05E1\u05D9\u05D4.
    \u05D4\u05DE\u05D9\u05D9\u05E0\u05D5\u05EA \u05D1\u05E8\u05D7\u05D5 \u05DE\u05E9\u05D1\u05D9
    \u05D1\u05E1\u05D5\u05E3 \u05E9\u05E0\u05D5\u05EA \u05D4\u05EA\u05E9\u05E2\u05D9\u05DD
    \u05D5\u05D4\u05EA\u05E4\u05E9\u05D8\u05D5 \u05D1\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA
    \u05D1\u05E8\u05D7\u05D1\u05D9 \u05D9\u05E9\u05E8\u05D0\u05DC.\n\n\u05E0\u05D5\u05DB\u05D7\u05D5\u05EA\u05DF
    \u05E4\u05D5\u05D2\u05E2\u05EA \u05E7\u05E9\u05D5\u05EA \u05D1\u05D7\u05D9\u05D5\u05EA
    \u05D4\u05D1\u05E8. \u05DE\u05D9\u05D9\u05E0\u05D5\u05EA \u05DE\u05EA\u05D7\u05E8\u05D5\u05EA
    \u05D1\u05D0\u05D2\u05E8\u05E1\u05D9\u05D1\u05D9\u05D5\u05EA \u05E2\u05DD \u05E6\u05D9\u05E4\u05D5\u05E8\u05D9\u05DD
    \u05DE\u05E7\u05D5\u05DE\u05D9\u05D5\u05EA \u05E2\u05DC \u05DE\u05D6\u05D5\u05DF
    \u05D5\u05E2\u05DC \u05D7\u05DC\u05DC\u05D9 \u05E7\u05D9\u05E0\u05D5\u05DF. \u05D4\u05DF
    \u05DE\u05E9\u05EA\u05DC\u05D8\u05D5\u05EA \u05E2\u05DC \u05E7\u05D9\u05E0\u05D9\u05DD
    \u05E9\u05DC \u05DE\u05D9\u05E0\u05D9\u05DD \u05DB\u05DE\u05D5 \u05D3\u05E8\u05D5\u05E8
    \u05D4\u05D1\u05D9\u05EA.\n\n\u05D4\u05DE\u05D9\u05D9\u05E0\u05D5\u05EA \u05D2\u05DD
    \u05E6\u05D3\u05D5\u05EA \u05D1\u05D0\u05D5\u05E4\u05DF \u05D9\u05E9\u05D9\u05E8.
    \u05D4\u05DF \u05D4\u05D5\u05E8\u05E1\u05D5\u05EA \u05E7\u05D9\u05E0\u05D9\u05DD
    \u05D5\u05D0\u05D5\u05DB\u05DC\u05D5\u05EA \u05D1\u05D9\u05E6\u05D9\u05DD \u05D5\u05D2\u05D5\u05D6\u05DC\u05D9\u05DD
    \u05E9\u05DC \u05E6\u05D9\u05E4\u05D5\u05E8\u05D9\u05DD \u05DE\u05E7\u05D5\u05DE\u05D9\u05D5\u05EA.
    \u05D4\u05EA\u05D5\u05E7\u05E4\u05E0\u05D5\u05EA \u05D4\u05D6\u05D5 \u05DE\u05E7\u05D8\u05D9\u05E0\u05D4
    \u05D0\u05EA \u05D0\u05D5\u05DB\u05DC\u05D5\u05E1\u05D9\u05D5\u05EA \u05D4\u05E6\u05D9\u05E4\u05D5\u05E8\u05D9\u05DD
    \u05E9\u05DC\u05E0\u05D5 \u05D5\u05D3\u05D5\u05D7\u05E7\u05EA \u05D0\u05D5\u05EA\u05DF
    \u05DE\u05D1\u05EA\u05D9 \u05D4\u05D2\u05D9\u05D3\u05D5\u05DC \u05E9\u05DC\u05D4\u05DF.\n\n\u05D4\u05D3\u05D5\u05DB\u05D9\u05E4\u05EA
    \u05D5\u05E9\u05D0\u05E8 \u05D4\u05E6\u05D9\u05E4\u05D5\u05E8\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5
    \u05D0\u05D5\u05DC\u05D9 \u05DE\u05E0\u05E6\u05D7\u05D5\u05EA \u05D1\u05DE\u05E9\u05D7\u05E7,
    \u05D0\u05D1\u05DC \u05D1\u05DE\u05E6\u05D9\u05D0\u05D5\u05EA, \u05D4\u05DF \u05D4\u05E4\u05E1\u05D9\u05D3\u05D5
    \u05DE\u05D6\u05DE\u05DF."
  m_isRightToLeft: 1
