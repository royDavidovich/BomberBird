%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6afb83b5193084588a2d4056de853d71, type: 3}
  m_Name: campaign
  m_EditorClassIdentifier: BomberBird.Flow::BomberBird.Flow.Campaign
  m_Stages:
  - m_HabitatName: First Steps Garden
    m_Layout: {fileID: 11400000, guid: ad78887da97f941a4a5617a1d8b023cd, type: 2}
    m_TileSet: {fileID: 11400000, guid: d2b69b68d229c44ddbb6c383f04b4b30, type: 2}
    m_HabitatHero: {fileID: 21300000, guid: 51f51ce3182bc4ff9835b62dc302fed9, type: 3}
    m_HabitatBlurb: A walled garden let go soft at the edges. The hoopoe works the soil for grubs, while mynas raid the pomegranate trees.
    m_BirdLine: home of the Eurasian hoopoe
    m_AwardedBird: {fileID: 0}
  - m_HabitatName: Orchard Grove
    m_Layout: {fileID: 11400000, guid: 8d4d97ed16304302aea9e8fab15d9976, type: 2}
    m_TileSet: {fileID: 11400000, guid: 21c11f90f54c4473a5b4dbe21560c915, type: 2}
    m_HabitatHero: {fileID: 21300000, guid: a6c47ebbbc0094baaba3ff5708ba8785, type: 3}
    m_HabitatBlurb: Rows of old fruit trees, heavy and close. Thick leaf litter offers rich feeding for the hoopoe, but the mynas are here too.
    m_BirdLine: home of the Eurasian hoopoe
    m_AwardedBird: {fileID: 0}
  - m_HabitatName: Stream Bank
    m_Layout: {fileID: 11400000, guid: 8d7d2db47621481f8eeae48c18aee73f, type: 2}
    m_TileSet: {fileID: 11400000, guid: ab40f6806b81454a99281f8948b67b40, type: 2}
    m_HabitatHero: {fileID: 21300000, guid: 267ffe549c25e4cd691a8ab75d978f87, type: 3}
    m_HabitatBlurb: 'Shallow water over stones, with a dirt bank cut into the far side.

      The kingfisher waits on low branches to dive for what swims below.'
    m_BirdLine: home of the white-throated kingfisher
    m_AwardedBird: {fileID: 11400000, guid: 19a4810925a0b461e88f4aa6b90ae12e, type: 2}
  - m_HabitatName: Lagoon Shore
    m_Layout: {fileID: 11400000, guid: 924e4331b8ca49968c00ab6c11d79019, type: 2}
    m_TileSet: {fileID: 11400000, guid: 2dfd643542e54515adb3f185a85d2042, type: 2}
    m_HabitatHero: {fileID: 21300000, guid: f758c130510264a5982565068c825ca1, type: 3}
    m_HabitatBlurb: 'Broad coastal waters offer the pelican a resting site

      on the migration route. Flocks land to scoop fish and wait out the heat.'
    m_BirdLine: home of the great white pelican
    m_AwardedBird: {fileID: 11400000, guid: 855760986c2b84e54bfa7256d7f25806, type: 2}
  - m_HabitatName: Rocky Upland
    m_Layout: {fileID: 11400000, guid: 8e7fe54346c5429f895d67c9ffcfd964, type: 2}
    m_TileSet: {fileID: 11400000, guid: cd801a67ca214e2cb23b14ac64bdc6f9, type: 2}
    m_HabitatHero: {fileID: 21300000, guid: f91585488d9214806b73afa8da0e6e72, type: 3}
    m_HabitatBlurb: 'Dry stone and low scrub on a hillside. The chukar

      prefers to run rather than fly, climbing the rocky slopes to forage.'
    m_BirdLine: home of the chukar partridge
    m_AwardedBird: {fileID: 11400000, guid: b2b399ae04ee545fa85f0a12006dfc3e, type: 2}
  - m_HabitatName: Overgrown Courtyard
    m_Layout: {fileID: 11400000, guid: 2def2d1844324d6787441cb65f52b4cf, type: 2}
    m_TileSet: {fileID: 11400000, guid: 106ca53536f74efda13d83b86e0e8cca, type: 2}
    m_HabitatHero: {fileID: 21300000, guid: 88dd623612fd74492aa9085684fb6bd2, type: 3}
    m_HabitatBlurb: 'A courtyard nobody tends. Every cavity that held a native bird

      holds a myna now, and the flock has stopped leaving.'
    m_BirdLine: taken by the common myna
    m_AwardedBird: {fileID: 0}
  m_StartingBird: {fileID: 11400000, guid: c8039b8a2bc4c4fd4bb325bd11fb32c4, type: 2}
